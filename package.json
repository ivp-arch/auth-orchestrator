{
  "name": "auth-orchestrator",
  "private": true,
  "version": "0.0.0",
  "description": "Modern OAuth2/OIDC client for React and Angular SPAs, secure PKCE, and a built-in AI diagnostician to automatically debug authentication errors in dev mode",
  "main": "module",
  "engines": {
    "node": ">= 22.10.0",
    "pnpm": ">= 11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@types/node": "25.9.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "turbo": "2.9.14",
    "typescript": "5.8.3"
  }
}
