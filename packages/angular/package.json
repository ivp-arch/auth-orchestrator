{
  "name": "@auth-orchestrator/angular",
  "version": "0.0.1",
  "description": "Angular adapter for Auth Orchestrator",
  "license": "MIT",
  "author": "ivp-arch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivp-arch/auth-orchestrator.git",
    "directory": "packages/angular"
  },
  "bugs": "https://github.com/ivp-arch/auth-orchestrator/issues",
  "keywords": [
    "angular",
    "oauth",
    "oauth2",
    "oidc",
    "authentication",
    "auth",
    "signals"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@angular/common": ">=21.0.0",
    "@angular/core": ">=21.0.0",
    "@angular/router": ">=21.0.0",
    "rxjs": ">=7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@auth-orchestrator/core": "workspace:*"
  },
  "devDependencies": {
    "@angular/common": "21.2.13",
    "@angular/core": "21.2.13",
    "@angular/router": "21.2.13",
    "@auth-orchestrator/tsup-config": "workspace:*",
    "@auth-orchestrator/vitest-preset": "workspace:*",
    "rxjs": "7.8.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "zone.js": "0.15.1"
  }
}
